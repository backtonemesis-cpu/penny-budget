{
  "name": "penny-budget",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node scripts/self-test.mjs && node scripts/source-audit.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "node scripts/dependency-audit.mjs",
    "build": "vite build",
    "check": "npm run audit:all && npm test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.5"
  }
}
